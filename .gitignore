# graft's local graph cache — regenerable, not committed (run `graft build`).
graft/

# Evaluation output
eval_results/
*.egg-info/

# Research assistant embedding cache (regenerated on first `ragadvisor ask`)
src/rag_adviser/research/.cache/

# Stray pip artefacts from unquoted version specs (e.g. a file literally named "=0.7.0")
=*
