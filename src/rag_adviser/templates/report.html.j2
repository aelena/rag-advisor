<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RAG Configuration Report — ragadvisor</title>
    <style>{{ css }}</style>
</head>
<body>

<h1>RAG Configuration Audit Report</h1>
<p class="meta">
    Generated by <strong>ragadvisor v{{ version }}</strong> on {{ generated_at }}<br>
    {% if answers.document_path %}Corpus: <code>{{ answers.document_path }}</code>{% endif %}
</p>

{# ── Approach Assessment ───────────────────────────────────────────── #}
{% if recommendations.approach and not recommendations.approach.proceed_with_rag %}
<h2>Approach Assessment</h2>
<div class="warning-box">
    <strong>Recommended approach:</strong>
    {{ recommendations.approach.recommended_approach.value.replace('_', ' ').title() }}
    (confidence: {{ "%.0f"|format(recommendations.approach.confidence * 100) }}%)
    <br><br>
    {{ recommendations.approach.reasoning }}
</div>
<h3>Alternative Approach</h3>
<p>{{ recommendations.approach.alternative_description }}</p>
<hr>
{% endif %}

{# ── Warnings ──────────────────────────────────────────────────────── #}
{% if recommendations.warnings %}
<h2>Warnings &amp; Critical Decisions</h2>
{% for w in recommendations.warnings %}
<div class="warning-box">{{ w }}</div>
{% endfor %}
{% endif %}

{# ── User Input Summary ───────────────────────────────────────────── #}
<h2>User Input Summary</h2>
<ul class="property-list">
    <li><strong>Use case:</strong> {{ answers.use_case.value }}</li>
    <li><strong>Deployment:</strong> {{ answers.constraints.environment.value }}</li>
    <li><strong>Hardware:</strong> {{ answers.constraints.hardware.value }}</li>
    <li><strong>RAM:</strong> {{ answers.constraints.ram_gb }} GB</li>
    {% if answers.constraints.vram_gb > 0 %}
    <li><strong>VRAM:</strong> {{ answers.constraints.vram_gb }} GB</li>
    {% endif %}
    <li><strong>Latency budget:</strong> {{ answers.constraints.latency_budget.value }}</li>
    <li><strong>Privacy:</strong> {{ answers.constraints.privacy.value }}</li>
    <li><strong>Budget:</strong> {{ answers.constraints.budget.value }}</li>
    <li><strong>Query type:</strong> {{ answers.query_type.value }}</li>
    <li><strong>Query complexity:</strong> {{ answers.query_complexity.value }}</li>
    <li><strong>Expected answer type:</strong> {{ answers.expected_answer_type.value }}</li>
    {% if answers.sample_queries %}
    <li><strong>Sample queries:</strong> {{ answers.sample_queries|join("; ") }}</li>
    {% endif %}
    <li><strong>Update frequency:</strong> {{ answers.update_frequency.value }}</li>
    <li><strong>Future languages:</strong> {{ "Yes" if answers.future_languages else "No" }}</li>
    <li><strong>Ground truth:</strong> {{ "Yes" if answers.has_ground_truth else "No" }}</li>
</ul>

{% if answers.document_stats %}
<h3>Document Corpus</h3>
<ul class="property-list">
    <li><strong>Total files:</strong> {{ answers.document_stats.total_files }}</li>
    <li><strong>Total size:</strong> {{ "%.1f"|format(answers.document_stats.total_size_bytes / 1048576) }} MB</li>
    <li><strong>Primary language:</strong> {{ answers.document_stats.primary_language }}</li>
    <li><strong>CJK content:</strong> {{ "Yes" if answers.document_stats.has_cjk else "No" }}</li>
    <li><strong>Content type:</strong> {{ answers.document_stats.detected_content_type.value }}</li>
    <li><strong>Avg tokens/doc:</strong> {{ "%.0f"|format(answers.document_stats.avg_tokens_per_doc) }}</li>
    <li><strong>Total tokens:</strong> {{ "{:,}".format(answers.document_stats.total_tokens) }}</li>
</ul>

{% if answers.document_stats.languages_detected %}
<h3>Language Distribution</h3>
<table>
    <tr><th>Language</th><th>Proportion</th></tr>
    {% for lang, pct in answers.document_stats.languages_detected.items()|sort(attribute='1', reverse=true) %}
    <tr><td>{{ lang }}</td><td>{{ "%.0f"|format(pct * 100) }}%</td></tr>
    {% endfor %}
</table>
{% endif %}
{% endif %}

<hr>

{# ── Embedding Model ──────────────────────────────────────────────── #}
{% if recommendations.modalities %}
<h2>Non-Text Modalities</h2>
<p>The text pipeline covers documents only. The corpus also contains:</p>
<table>
    <tr><th>Modality</th><th>Files</th><th>Share</th><th>Strategy</th></tr>
    {% for m in recommendations.modalities %}
    <tr><td>{{ m.modality|replace("_", " ") }}</td><td>{{ m.file_count }}</td><td>{{ "%.0f"|format(m.share * 100) }}%</td><td>{{ m.strategy }}</td></tr>
    {% endfor %}
</table>
{% for m in recommendations.modalities %}
<h3>{{ m.modality|replace("_", " ")|title }}</h3>
<ul class="property-list">
    {% if m.extensions %}<li><strong>Extensions:</strong> {{ m.extensions|join(", ") }}</li>{% endif %}
    <li><strong>Embedding:</strong> {{ m.embedding }}</li>
    <li><strong>Chunking:</strong> {{ m.chunking }}</li>
    {% if m.tools_local %}<li><strong>Local tools:</strong> {{ m.tools_local|join("; ") }}</li>{% endif %}
    {% if m.tools_hosted %}<li><strong>Hosted services:</strong> {{ m.tools_hosted|join("; ") }}</li>{% endif %}
</ul>
{% if m.ingestion %}<ol>{% for s in m.ingestion %}<li>{{ s }}</li>{% endfor %}</ol>{% endif %}
{% for n in m.notes %}<div class="info-box">{{ n }}</div>{% endfor %}
{% for w in m.warnings %}<div class="warning-box">{{ w }}</div>{% endfor %}
{% if m.code_snippet %}<pre><code>{{ m.code_snippet }}</code></pre>{% endif %}
{% endfor %}
<hr>
{% endif %}

<h2>Embedding Model</h2>
{% if recommendations.embedding_models %}
{% set top = recommendations.embedding_models[0] %}
<div class="info-box">
    <strong>Recommended:</strong> <code>{{ top.model_id }}</code>
    <span class="score-badge {% if top.score >= 0.7 %}score-high{% elif top.score >= 0.4 %}score-medium{% else %}score-low{% endif %}">
        Score: {{ "%.2f"|format(top.score) }}
    </span>
</div>

<ul class="property-list">
    <li><strong>Provider:</strong> {{ top.provider }}</li>
    {% if top.quality_score > 0 %}
    <li><strong>Retrieval quality:</strong> ~{{ "%.0f"|format(top.quality_score) }} (approx. MTEB nDCG@10)</li>
    {% endif %}
    <li><strong>Dimension:</strong> {{ top.dimension }}</li>
    <li><strong>Max tokens:</strong> {{ top.max_tokens }}</li>
    <li><strong>Size:</strong> {{ top.estimated_size_gb }} GB</li>
    <li><strong>License:</strong> {{ top.license }}</li>
    <li><strong>Multilingual:</strong> {{ "Yes" if top.multilingual else "No" }}</li>
</ul>

{% if top.reasons %}
<h3>Why Selected</h3>
<ul>
{% for r in top.reasons %}
    <li>{{ r }}</li>
{% endfor %}
</ul>
{% endif %}

{% if top.warnings %}
<h3>Model Warnings</h3>
{% for w in top.warnings %}
<div class="warning-box">{{ w }}</div>
{% endfor %}
{% endif %}

{% if recommendations.embedding_models|length > 1 %}
<h3>Alternative Models</h3>
<table>
    <tr>
        <th>Model</th>
        <th>Provider</th>
        <th>Score</th>
        <th>Quality</th>
        <th>Dimension</th>
        <th>Max Tokens</th>
        <th>Size (GB)</th>
        <th>Multilingual</th>
    </tr>
    {% for m in recommendations.embedding_models %}
    <tr>
        <td><code>{{ m.model_id }}</code></td>
        <td>{{ m.provider }}</td>
        <td>
            <span class="score-badge {% if m.score >= 0.7 %}score-high{% elif m.score >= 0.4 %}score-medium{% else %}score-low{% endif %}">
                {{ "%.2f"|format(m.score) }}
            </span>
        </td>
        <td>{% if m.quality_score > 0 %}~{{ "%.0f"|format(m.quality_score) }}{% else %}n/a{% endif %}</td>
        <td>{{ m.dimension }}</td>
        <td>{{ m.max_tokens }}</td>
        <td>{% if m.provider != "huggingface" %}API{% else %}{{ m.estimated_size_gb }}{% endif %}</td>
        <td>{{ "Yes" if m.multilingual else "No" }}</td>
    </tr>
    {% endfor %}
</table>
{% endif %}
{% else %}
<div class="danger-box">No suitable models found matching your constraints.</div>
{% endif %}

<hr>

{# ── Chunking Strategy ────────────────────────────────────────────── #}
<h2>Chunking Strategy</h2>
{% if recommendations.chunking %}
{% set c = recommendations.chunking %}
<ul class="property-list">
    <li><strong>Strategy:</strong> {{ c.strategy }}</li>
    <li><strong>Chunk size:</strong> {{ c.chunk_size }} {{ c.count_by }}</li>
    <li><strong>Overlap:</strong> {{ c.chunk_overlap }} {{ c.count_by }}</li>
    <li><strong>Content type:</strong> {{ c.content_type }}</li>
</ul>

{% if c.notes %}
<h3>Notes</h3>
<ul>
{% for n in c.notes %}
    <li>{{ n }}</li>
{% endfor %}
</ul>
{% endif %}

{% if c.language_overrides %}
<h3>Language-Specific Overrides</h3>
<table>
    <tr><th>Language</th><th>Chunk Size</th><th>Count By</th><th>Tokenizer</th></tr>
    {% for lang, override in c.language_overrides.items() %}
    <tr>
        <td>{{ lang.upper() }}</td>
        <td>{{ override.get("chunk_size", "-") }}</td>
        <td>{{ override.get("count_by", "-") }}</td>
        <td><code>{{ override.get("tokenizer", override.get("sentence_model", "-")) }}</code></td>
    </tr>
    {% endfor %}
</table>
{% endif %}

{% if c.code_snippet %}
<h3>Code Snippet</h3>
<pre><code>{{ c.code_snippet }}</code></pre>
{% endif %}
{% endif %}

<hr>

{# ── Vector Database ──────────────────────────────────────────────── #}
<h2>Vector Database</h2>
{% if recommendations.vector_db %}
{% set db = recommendations.vector_db %}
<div class="info-box">
    <strong>Recommended:</strong> {{ db.provider }} (<code>pip install {{ db.library }}</code>)
</div>

<ul class="property-list">
    <li><strong>Category:</strong> {{ db.category }}</li>
    <li><strong>Reason:</strong> {{ db.reason }}</li>
    {% if db.estimated_capacity %}
    <li><strong>Capacity:</strong> {{ db.estimated_capacity }}</li>
    {% endif %}
    <li><strong>Metadata filtering:</strong> {{ "Yes" if db.supports_metadata_filter else "No" }}</li>
    <li><strong>Hybrid search:</strong> {{ "Yes" if db.supports_hybrid_search else "No" }}</li>
</ul>

{% if db.code_snippet %}
<h3>Code Snippet</h3>
<pre><code>{{ db.code_snippet }}</code></pre>
{% endif %}
{% endif %}

<hr>

{# ── Retrieval Settings ───────────────────────────────────────────── #}
<h2>Retrieval Settings</h2>
{% if recommendations.retrieval %}
{% set r = recommendations.retrieval %}
<ul class="property-list">
    <li><strong>Top-K:</strong> {{ r.top_k }}</li>
    <li><strong>Similarity Threshold:</strong> {{ r.similarity_threshold }}</li>
    <li><strong>Reranking:</strong> {{ "Yes" if r.rerank else "No" }}</li>
    {% if r.rerank and r.rerank_model %}
    <li><strong>Reranker:</strong> <code>{{ r.rerank_model }}</code></li>
    {% endif %}
    <li><strong>Hybrid Search:</strong> {{ "Yes" if r.hybrid_search else "No" }}</li>
</ul>

{% if r.hybrid_search %}
<h3>Hybrid Retrieval</h3>
<ul class="property-list">
    <li><strong>Sparse retriever:</strong> {{ r.sparse_method|upper }}
        ({{ "native in the vector DB" if r.hybrid_native else "in-process (rank-bm25)" }})</li>
    <li><strong>Fusion:</strong> {{ r.fusion_method|upper }}</li>
</ul>
{% if r.hybrid_reasons %}
<ul>
{% for reason in r.hybrid_reasons %}
    <li>{{ reason }}</li>
{% endfor %}
</ul>
{% endif %}
{% if r.hybrid_code_snippet %}
<pre><code>{{ r.hybrid_code_snippet }}</code></pre>
{% endif %}
{% endif %}

{% if r.prompt_strategy != "none" %}
<h3>Generation Settings</h3>
<ul class="property-list">
    <li><strong>Temperature:</strong> {{ r.temperature }}</li>
    <li><strong>Max Tokens:</strong> {{ r.max_tokens }}</li>
    <li><strong>Prompt Strategy:</strong> {{ r.prompt_strategy }}</li>
</ul>
{% endif %}

{% if r.notes %}
<h3>Notes</h3>
<ul>
{% for n in r.notes %}
    <li>{{ n }}</li>
{% endfor %}
</ul>
{% endif %}
{% endif %}

<hr>

{# ── Query Pipeline ───────────────────────────────────────────────── #}
{% if recommendations.reranker %}
{% set rr = recommendations.reranker %}
<h2>Reranking</h2>
{% if not rr.enabled %}
<p><strong>Not recommended for this profile.</strong></p>
<ul>
{% for n in rr.notes %}<li>{{ n }}</li>{% endfor %}
{% for w in rr.warnings %}<li class="warning-box">{{ w }}</li>{% endfor %}
</ul>
{% else %}
<div class="info-box">
    <strong>Recommended:</strong> <code>{{ rr.model_id }}</code>
    <span class="score-badge {% if rr.score >= 0.7 %}score-high{% elif rr.score >= 0.4 %}score-medium{% else %}score-low{% endif %}">
        Score: {{ "%.2f"|format(rr.score) }}
    </span>
</div>
<ul class="property-list">
    <li><strong>Provider:</strong> {{ rr.provider }}</li>
    <li><strong>Pipeline:</strong> retrieve top {{ rr.fetch_k }} &rarr; rerank &rarr; keep {{ rr.final_k }}</li>
    <li><strong>Estimated latency:</strong> ~{{ rr.estimated_latency_ms }} ms</li>
    <li><strong>Relative quality:</strong> ~{{ "%.0f"|format(rr.quality_score) }}/100 (approx.)</li>
    <li><strong>Input window:</strong> {{ rr.max_tokens }} tokens</li>
    <li><strong>Multilingual:</strong> {{ "Yes" if rr.multilingual else "No" }}</li>
    <li><strong>License:</strong> {{ rr.license }}</li>
</ul>
{% if rr.reasons %}
<h3>Why Rerank</h3>
<ul>{% for r in rr.reasons %}<li>{{ r }}</li>{% endfor %}</ul>
{% endif %}
{% if rr.warnings %}
<h3>Warnings</h3>
{% for w in rr.warnings %}<div class="warning-box">{{ w }}</div>{% endfor %}
{% endif %}
{% if rr.alternatives %}
<h3>Alternatives</h3>
<table>
    <tr><th>Model</th><th>Provider</th><th>Score</th><th>Quality</th><th>Latency</th></tr>
    {% for a in rr.alternatives %}
    <tr><td><code>{{ a.model_id }}</code></td><td>{{ a.provider }}</td><td>{{ "%.2f"|format(a.score) }}</td><td>~{{ "%.0f"|format(a.quality_score) }}</td><td>~{{ a.estimated_latency_ms }} ms</td></tr>
    {% endfor %}
</table>
{% endif %}
{% if rr.code_snippet %}
<pre><code>{{ rr.code_snippet }}</code></pre>
{% endif %}
{% endif %}
<hr>
{% endif %}

{% if recommendations.estimates %}
{% set e = recommendations.estimates %}
<h2>Cost, Footprint &amp; Latency Estimates</h2>
<p>Order-of-magnitude figures for planning; compare them, do not bill against them.</p>
<table>
    <tr><th>Item</th><th>Estimate</th></tr>
    {% if e.chunk_count %}
    <tr><td>Corpus tokens</td><td>{{ '~' if e.corpus_tokens_estimated }}{{ '{:,}'.format(e.corpus_tokens) }}</td></tr>
    <tr><td>Chunks to index</td><td>{{ '~' if e.corpus_tokens_estimated }}{{ '{:,}'.format(e.chunk_count) }}</td></tr>
    <tr><td>Index on disk</td><td>~{{ '%.0f'|format(e.index_size_mb) }} MB</td></tr>
    <tr><td>Vectors in RAM</td><td>~{{ '%.0f'|format(e.index_memory_mb) }} MB</td></tr>
    {% if e.embedding_is_api %}<tr><td>One-off embedding cost</td><td>~${{ '%.2f'|format(e.indexing_cost_usd) }}</td></tr>{% endif %}
    <tr><td>Indexing time</td><td>~{{ '%.0f'|format(e.indexing_time_min) }} min</td></tr>
    {% endif %}
    <tr><td>Retrieval latency per query</td><td>~{{ e.query_latency_ms }} ms
        <span class="score-badge {{ 'score-high' if e.fits_latency_budget else 'score-low' }}">{{ 'fits' if e.fits_latency_budget else 'exceeds' }} budget</span></td></tr>
    {% if e.queries_per_day %}<tr><td>Monthly query-side API cost</td><td>~${{ '%.2f'|format(e.monthly_query_cost_usd) }} at {{ '{:,}'.format(e.queries_per_day) }} queries/day</td></tr>{% endif %}
</table>
{% if e.query_latency_breakdown_ms %}<p><strong>Latency breakdown (ms):</strong> {% for k, v in e.query_latency_breakdown_ms.items() %}{{ k|replace('_', ' ') }} {{ v }}{% if not loop.last %}, {% endif %}{% endfor %}</p>{% endif %}
{% for w in e.warnings %}<div class="warning-box">{{ w }}</div>{% endfor %}
{% for n in e.notes %}<div class="info-box">{{ n }}</div>{% endfor %}
{% if e.assumptions %}<h3>Assumptions</h3><ul>{% for a in e.assumptions %}<li>{{ a }}</li>{% endfor %}</ul>{% endif %}
<hr>
{% endif %}

{% if recommendations.validation %}
{% set v = recommendations.validation %}
<h2>Validation Against Ground Truth</h2>
{% if not v.ran %}
<div class="warning-box">Validation did not run: {{ v.error }}</div>
{% else %}
<div class="info-box">
    <strong>Verdict:</strong>
    <span class="score-badge {% if v.verdict == 'strong' %}score-high{% elif v.verdict == 'acceptable' %}score-medium{% else %}score-low{% endif %}">{{ v.verdict }}</span>
    ({{ v.num_queries }} queries, {{ v.num_chunks }} chunks)
</div>
<ul class="property-list">
    <li><strong>Chunking strategy:</strong> {{ v.strategy }} @ {{ v.chunk_size_chars }} / {{ v.chunk_overlap_chars }} chars</li>
    <li><strong>Embedding model:</strong> <code>{{ v.embedding_model }}</code></li>
    <li><strong>Vector backend:</strong> {{ v.vector_backend }}</li>
    <li><strong>Top-K:</strong> {{ v.top_k }}</li>
    <li><strong>Retrieval mode:</strong> {{ v.retrieval_mode }}{% if v.reranker_model %} (reranker <code>{{ v.reranker_model }}</code>){% endif %}</li>
</ul>
<table>
    <tr><th>Metric</th><th>Value</th></tr>
    <tr><td>Hit Rate@{{ v.top_k }}</td><td>{{ "%.1f"|format(v.hit_rate * 100) }}%</td></tr>
    <tr><td>MRR</td><td>{{ "%.3f"|format(v.mrr) }}</td></tr>
    <tr><td>Precision@{{ v.top_k }}</td><td>{{ "%.1f"|format(v.precision_at_k * 100) }}%</td></tr>
    <tr><td>Recall@{{ v.top_k }}</td><td>{{ "%.1f"|format(v.recall_at_k * 100) }}%</td></tr>
    <tr><td>nDCG@{{ v.top_k }}</td><td>{{ "%.3f"|format(v.ndcg_at_k) }}</td></tr>
    {% for c in v.chunk_size_comparison %}
    <tr><td>Chunk size {{ c.chunk_size_tokens }} tokens{% if c.chunk_size_tokens == v.recommended_chunk_size_tokens %} (recommended){% endif %}</td><td>hit rate {{ "%.1f"|format(c.hit_rate * 100) }}%, MRR {{ "%.3f"|format(c.mrr) }}</td></tr>
    {% endfor %}
    {% for c in v.model_comparison %}
    <tr><td>{{ 'Best model' if loop.first else 'Alternative' }}: <code>{{ c.model }}</code></td><td>hit rate {{ "%.1f"|format(c.hit_rate * 100) }}%, MRR {{ "%.3f"|format(c.mrr) }}</td></tr>
    {% endfor %}
    {% if v.has_baseline %}
    <tr><td>Dense-only baseline</td><td>hit rate {{ "%.1f"|format(v.baseline_hit_rate * 100) }}%, MRR {{ "%.3f"|format(v.baseline_mrr) }}</td></tr>
    {% endif %}
</table>
{% if v.suggestions %}
<h3>Next Steps</h3>
<ul>
{% for s in v.suggestions %}
    <li>{{ s }}</li>
{% endfor %}
</ul>
{% endif %}
{% endif %}
<hr>
{% endif %}

{% if recommendations.query_transformation and recommendations.query_transformation.techniques %}
<h2>Query Pipeline</h2>
<p>
    Estimated latency impact: <strong>~{{ recommendations.query_transformation.latency_impact_ms }}ms</strong> |
    Requires LLM: <strong>{{ "Yes" if recommendations.query_transformation.requires_llm else "No" }}</strong>
</p>

{% for tech in recommendations.query_transformation.techniques %}
<div class="info-box">
    <strong>{{ tech.name }}</strong>
    {% if tech.priority == "required" %}
    <span class="score-badge score-low">REQUIRED</span>
    {% elif tech.priority == "recommended" %}
    <span class="score-badge score-medium">RECOMMENDED</span>
    {% else %}
    <span class="score-badge score-high">OPTIONAL</span>
    {% endif %}
    <p>{{ tech.description }}</p>
</div>
{% endfor %}

{% if recommendations.query_transformation.notes %}
<h3>Notes</h3>
<ul>
{% for n in recommendations.query_transformation.notes %}
    <li>{{ n }}</li>
{% endfor %}
</ul>
{% endif %}

{% if recommendations.query_transformation.code_snippet %}
<h3>Code Snippet</h3>
<pre><code>{{ recommendations.query_transformation.code_snippet }}</code></pre>
{% endif %}
<hr>
{% endif %}

{# ── Implementation Checklist ─────────────────────────────────────── #}
<h2>Implementation Checklist</h2>
<ul class="checklist">
{% for step in recommendations.implementation_steps %}
    <li><code>{{ step }}</code></li>
{% endfor %}
</ul>

<hr>

{# ── Re-Indexing Warning ──────────────────────────────────────────── #}
<h2>Re-Indexing Warning</h2>
<div class="danger-box">
    <strong>CRITICAL:</strong> If you change the embedding model in the future, you MUST re-index all documents.
    Vector spaces are not compatible across different models.<br><br>
    {% if answers.document_stats %}
    <strong>Current languages:</strong> {{ answers.document_stats.languages_detected.keys()|join(", ") }}<br>
    {% endif %}
    <strong>Future languages planned:</strong> {{ "Yes" if answers.future_languages else "No" }}<br>
    {% if recommendations.embedding_models %}
    <strong>Multilingual model selected:</strong> {{ "Yes" if recommendations.embedding_models[0].multilingual else "No" }}
    {% endif %}
</div>

<footer>
    Generated by ragadvisor v{{ version }} &mdash; RAG Configuration Adviser
</footer>

</body>
</html>
